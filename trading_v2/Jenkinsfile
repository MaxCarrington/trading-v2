// Jenkinsfile
// -----------
// Triggered on every push to Bitbucket.
// For each strategy config found, runs the backtest, saves results to SQLite,
// and publishes an HTML report viewable inside Jenkins.
//
// REQUIREMENTS in Jenkins:
//   - "HTML Publisher" plugin  (Manage Jenkins → Plugins)
//   - A Python 3 virtualenv or system Python with your dependencies installed
//   - BACKTEST_DB env var (optional) — defaults to backtest_results.db in workspace

pipeline {

    agent any

    environment {
        // Path to the SQLite database file — persisted across builds via a fixed path.
        // Change this to an absolute path outside the workspace if you want it to survive
        // a workspace wipe (e.g. /var/jenkins_home/backtest_results.db).
        BACKTEST_DB = "${WORKSPACE}/backtest_results.db"

        // Subdirectory within the repo where the project lives
        PROJECT_DIR = "trading_v2"

        // Folder where strategy config files live (relative to repo root)
        CONFIGS_DIR = "trading_v2/configs"

        // Direct path to the conda environment's Python binary
        PYTHON = "/opt/homebrew/Caskroom/miniconda/base/envs/trading-env/bin/python"
    }

    stages {

        stage('Setup') {
            steps {
                echo "Verifying Python environment..."
                sh "${PYTHON} --version"
                sh "pwd"
                sh "ls -la ${PROJECT_DIR}/"
            }
        }

        stage('Run Backtests') {
            steps {
                script {
                    // Find every backtest_*.yaml config file in the configs directory
                    def configs = sh(
                        script: "find ${CONFIGS_DIR} -name 'backtest_*.yaml' | sort",
                        returnStdout: true
                    ).trim()

                    if (configs == '') {
                        error("No backtest_*.yaml config files found in ${CONFIGS_DIR}/")
                    }

                    configs.split('\n').each { config ->
                        def configName  = config.replace('trading_v2/configs/', '')
                        def metricsFile = config.replace('.yaml', '_metrics.json')
                        echo "Running backtest for: ${configName}"

                        // cd into trading_v2/ first so that 'src.trading' is importable
                        // 1. Run the backtest — saves trade records CSV to results/
                        sh "cd ${PROJECT_DIR} && ${PYTHON} scripts/run_backtest.py --config ${configName}"

                        // 2. Compute metrics and persist to SQLite
                        sh "cd ${PROJECT_DIR} && ${PYTHON} scripts/save_results.py --config configs/${configName} --metrics-file ${metricsFile} --db ${BACKTEST_DB} --build ${env.BUILD_NUMBER}"
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                echo "Generating HTML report..."
                sh "cd ${PROJECT_DIR} && ${PYTHON} scripts/generate_report.py --output reports/report.html --last 20 --db ${BACKTEST_DB}"
            }
        }

        stage('Publish Report') {
            steps {
                publishHTML(target: [
                    allowMissing:          false,
                    alwaysLinkToLastBuild: true,
                    keepAll:               true,
                    reportDir:             'trading_v2/reports',
                    reportFiles:           'report.html',
                    reportName:            'Backtest Report',
                    reportTitles:          'Backtest Results'
                ])
            }
        }
    }

    post {
        always {
            echo "Pipeline complete. View the Backtest Report tab for results."
        }
        failure {
            echo "Pipeline FAILED — check console output above for errors."
        }
    }
}
