pipeline {
    agent any

    environment {
        VENV_DIR    = '.venv'
        CONFIG_FILE = 'backtest_config.yaml'
        // Subdirectory within the repo where the project lives
        PROJECT_DIR = 'trading_v2'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {

        // -------------------------------------------------------------------
        stage('Checkout') {
        // -------------------------------------------------------------------
            steps {
                checkout scm
                echo "Branch: ${env.BRANCH_NAME ?: 'unknown'} | Build: ${env.BUILD_NUMBER}"
            }
        }

        // -------------------------------------------------------------------
        stage('Setup Python Environment') {
        // -------------------------------------------------------------------
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        python3 -m venv ${VENV_DIR}
                        . ${VENV_DIR}/bin/activate
                        pip install --upgrade pip --quiet
                        pip install -e ".[dev]" --quiet
                    '''
                }
            }
        }

        // -------------------------------------------------------------------
        stage('Lint') {
        // -------------------------------------------------------------------
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        . ${VENV_DIR}/bin/activate
                        ruff check src/ scripts/ --output-format=text || true
                    '''
                }
            }
        }

        // -------------------------------------------------------------------
        stage('Unit Tests') {
        // -------------------------------------------------------------------
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        . ${VENV_DIR}/bin/activate
                        pytest tests/ -v --tb=short --junitxml=test_results.xml || true
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "${PROJECT_DIR}/test_results.xml"
                }
            }
        }

        // -------------------------------------------------------------------
        stage('Run Backtest') {
        // -------------------------------------------------------------------
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        . ${VENV_DIR}/bin/activate
                        python scripts/run_backtest.py --config ${CONFIG_FILE}
                    '''
                }
            }
        }

        // -------------------------------------------------------------------
        stage('Generate Performance Report') {
        // -------------------------------------------------------------------
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        . ${VENV_DIR}/bin/activate
                        python scripts/generate_metrics_report.py
                    '''
                }
            }
        }

        // -------------------------------------------------------------------
        stage('Publish Results') {
        // -------------------------------------------------------------------
            steps {
                archiveArtifacts artifacts: "${PROJECT_DIR}/results/**/*.csv, ${PROJECT_DIR}/results/**/*.json",
                                 allowEmptyArchive: true,
                                 fingerprint: true

                publishHTML(target: [
                    allowMissing:          false,
                    alwaysLinkToLastBuild: true,
                    keepAll:               true,
                    reportDir:             "${PROJECT_DIR}/results/reports",
                    reportFiles:           'performance_report.html',
                    reportName:            'Backtest Performance Report'
                ])
            }
        }
    }

    post {
        success {
            echo "Backtest pipeline completed successfully - build #${env.BUILD_NUMBER}"
        }
        failure {
            echo "Backtest pipeline FAILED on build #${env.BUILD_NUMBER}. Check stage logs above."
        }
        always {
            echo "Pipeline finished."
        }
    }
}
