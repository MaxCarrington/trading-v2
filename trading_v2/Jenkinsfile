// Jenkinsfile

// Jenkins calls a function to generate random backtest data, which chooses a random period of data to test the strategy on. 
// If the data does not exist, the data is then generated using: scripts/generate_backtest_data.py
// The strategy is then run based on the strategy branch that the push/commit is on, using an akin command to: python scripts/run_backtest.py --config configs/temp.yaml
// Once the strategy has run, the results of the strategy are then generated with: python scripts/generate_metrics_report.py.
// Once the results have been generated, the results, strategy config and strategy code are then saved in the Jenkins results directory.

pipeline {

    agent any

    environment {
        // Path to the SQLite database file — persisted across builds via a fixed path.
        // Change this to an absolute path outside the workspace if you want it to survive
        // a workspace wipe (e.g. /var/jenkins_home/backtest_results.db).
        BACKTEST_DB = "${WORKSPACE}/backtest_results.db"

        // Subdirectory within the repo where the project lives
        PROJECT_DIR = "trading_v2"

        // Folder where strategy config files live (relative to repo root)
        CONFIGS_DIR = "trading_v2/configs"

        // Direct path to the conda environment's Python binary
        PYTHON = "/opt/homebrew/Caskroom/miniconda/base/envs/trading-env/bin/python"
    }

    stages {

        stage('Setup') {
            steps {
                echo "Verifying Python environment..."
                sh "${PYTHON} --version"
                sh "pwd"
                sh "ls -la ${PROJECT_DIR}/"
            }
        }

        stage('Run Backtests') {
            steps {
                script {
                    // Find every backtest_*.yaml config file in the configs directory
                    def configs = sh(
                        script: "find ${CONFIGS_DIR} -name 'backtest_*.yaml' | sort",
                        returnStdout: true
                    ).trim()

                    if (configs == '') {
                        error("No backtest_*.yaml config files found in ${CONFIGS_DIR}/")
                    }

                    configs.split('\n').each { config ->
                        def metricsFile = config.replace('.yaml', '_metrics.json')
                        echo "Running backtest for: ${config}"

                        // 1. Run the backtest — saves trade records CSV to results/
                        sh "${PYTHON} ${PROJECT_DIR}/scripts/run_backtest.py --config ${config.replace('trading_v2/configs/', '')}"

                        // 2. Compute metrics and persist to SQLite
                        sh "${PYTHON} ${PROJECT_DIR}/scripts/save_results.py --config ${config} --metrics-file ${metricsFile} --db ${BACKTEST_DB} --build ${env.BUILD_NUMBER}"
                    }
                }
            }
        }

        stage('Generate Report') {
            steps {
                echo "Generating HTML report..."
                sh "${PYTHON} ${PROJECT_DIR}/scripts/generate_report.py --output ${PROJECT_DIR}/reports/report.html --last 20 --db ${BACKTEST_DB}"
            }
        }

        stage('Publish Report') {
            steps {
                publishHTML(target: [
                    allowMissing:          false,
                    alwaysLinkToLastBuild: true,
                    keepAll:               true,
                    reportDir:             'trading_v2/reports',
                    reportFiles:           'report.html',
                    reportName:            'Backtest Report',
                    reportTitles:          'Backtest Results'
                ])
            }
        }
    }

    post {
        always {
            echo "Pipeline complete. View the Backtest Report tab for results."
        }
        failure {
            echo "Pipeline FAILED — check console output above for errors."
        }
    }
}
 